<Window x:Class="Bunshin.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bunshin — verified copy" Width="960" Height="900" MinWidth="760" MinHeight="640"
        WindowStyle="None" Icon="Branding/bunshin.ico"
        Background="{DynamicResource Paper}" Foreground="{DynamicResource Ink}"
        FontFamily="./Fonts/#Space Grotesk" FontSize="14"
        AllowDrop="True" PreviewDragOver="OnDragOver" Drop="OnDrop" Closing="Window_Closing">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="76" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="Paper" Color="#FAFBF9"/>
        <SolidColorBrush x:Key="Ink" Color="#242B2B"/>
        <SolidColorBrush x:Key="Dim" Color="#59645E"/>
        <SolidColorBrush x:Key="Line" Color="#D9DFDA"/>
        <SolidColorBrush x:Key="Soft" Color="#EEF2FD"/>
        <SolidColorBrush x:Key="Accent" Color="#315CE1"/>
        <SolidColorBrush x:Key="OnAccent" Color="White"/>
        <SolidColorBrush x:Key="Hover" Color="#E8EDE8"/>
        <SolidColorBrush x:Key="Pressed" Color="#D9E1DA"/>
        <SolidColorBrush x:Key="PrimaryHover" Color="#244BC5"/>
        <SolidColorBrush x:Key="PrimaryPressed" Color="#193AA1"/>
        <SolidColorBrush x:Key="Success" Color="#247347"/>
        <SolidColorBrush x:Key="Failure" Color="#B33232"/>
        <DrawingImage x:Key="BrandMark">
            <DrawingImage.Drawing><DrawingGroup>
                <GeometryDrawing Geometry="M32 82H28Q20 82 20 74V28Q20 20 28 20H74Q82 20 82 28V32"><GeometryDrawing.Pen><Pen Brush="{DynamicResource Accent}" Thickness="10" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="46,46,62,62" RadiusX="12" RadiusY="12"/></GeometryDrawing.Geometry><GeometryDrawing.Pen><Pen Brush="{DynamicResource Accent}" Thickness="10"/></GeometryDrawing.Pen></GeometryDrawing>
            </DrawingGroup></DrawingImage.Drawing>
        </DrawingImage>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style x:Key="Path" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontFamily" Value="./Fonts/#IBM Plex Mono"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle"><Setter.Value><Style><Setter Property="Control.Template"><Setter.Value><ControlTemplate><Rectangle Margin="-4" Stroke="{DynamicResource Ink}" StrokeThickness="1" StrokeDashArray="2,2" RadiusX="6" RadiusY="6"/></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter>
            <Setter Property="Background" Value="{DynamicResource Paper}"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Button_PointerDown"/>
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="Button_PointerUp"/>
            <EventSetter Event="MouseLeave" Handler="Button_PointerUp"/>
            <EventSetter Event="LostMouseCapture" Handler="Button_PointerUp"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Hover}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource Pressed}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Bd" Property="BorderThickness" Value="2"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Line}"/><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Foreground" Value="{DynamicResource Dim}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource PrimaryHover}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource PrimaryPressed}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Paper}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Padding" Value="10,9"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Ink}"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}" HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Field" Property="Background" Value="{DynamicResource Line}"/><Setter Property="Foreground" Value="{DynamicResource Dim}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="HeaderGrip" TargetType="Thumb">
            <Setter Property="Width" Value="6"/><Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Hover}"/><Setter Property="Foreground" Value="{DynamicResource Dim}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="FontFamily" Value="./Fonts/#Space Grotesk"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border x:Name="Header" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <DockPanel><Path x:Name="SortArrow" DockPanel.Dock="Right" Data="M0 4L4 0L8 4Z" Fill="{DynamicResource Dim}" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"/><ContentPresenter VerticalAlignment="Center"/></DockPanel>
                        </Border>
                        <Thumb x:Name="PART_LeftHeaderGripper" Style="{StaticResource HeaderGrip}" HorizontalAlignment="Left"/>
                        <Thumb x:Name="PART_RightHeaderGripper" Style="{StaticResource HeaderGrip}" HorizontalAlignment="Right"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Header" Property="Background" Value="{DynamicResource Pressed}"/></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Header" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                        <Trigger Property="SortDirection" Value="Ascending"><Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="SortDirection" Value="Descending"><Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/><Setter TargetName="SortArrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="RadioButton"><Setter Property="Margin" Value="0,0,28,0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="Expander"><Setter Property="Margin" Value="0,16,0,0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
        <Style x:Key="ScrollPage" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent">
                        <Border x:Name="Grip" Background="{DynamicResource Dim}" Opacity="0.75" CornerRadius="3" Margin="4,2"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Opacity" Value="0.85"/></Trigger>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Grip" Property="Opacity" Value="1"/></Trigger>
                        <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="Horizontal"><Setter TargetName="Grip" Property="Margin" Value="2,4"/></DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
            <Style.Triggers><DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="Horizontal"><Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="28"/></DataTrigger></Style.Triggers>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="14"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton><RepeatButton x:Name="Back" Style="{StaticResource ScrollPage}" Command="{x:Static ScrollBar.PageUpCommand}"/></Track.DecreaseRepeatButton>
                            <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
                            <Track.IncreaseRepeatButton><RepeatButton x:Name="Forward" Style="{StaticResource ScrollPage}" Command="{x:Static ScrollBar.PageDownCommand}"/></Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            <Setter TargetName="Back" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/>
                            <Setter TargetName="Forward" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
            <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="14"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="WindowControl" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Width" Value="46"/><Setter Property="Height" Value="36"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Grid DockPanel.Dock="Top" Height="76" Background="{DynamicResource Paper}">
            <StackPanel Orientation="Horizontal" Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <Image Source="{StaticResource BrandMark}" Width="32" Height="32" Margin="0,0,14,0"/>
                <TextBlock Text="Bunshin" FontFamily="./Fonts/#Bricolage Grotesque" FontWeight="SemiBold" FontSize="27" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0">
                <Button x:Name="MinimizeButton" Content="&#xE921;" Style="{StaticResource WindowControl}" Click="Minimize_Click" AutomationProperties.Name="Minimize" ToolTip="Minimize"/>
                <Button x:Name="MaximizeButton" Click="Maximize_Click" AutomationProperties.Name="Maximize or restore" ToolTip="Maximize or restore">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource WindowControl}"><Setter Property="Content" Value="&#xE922;"/><Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Content" Value="&#xE923;"/></DataTrigger></Style.Triggers></Style></Button.Style>
                </Button>
                <Button x:Name="CloseButton" Content="&#xE8BB;" Style="{StaticResource WindowControl}" Click="Close_Click" AutomationProperties.Name="Close" ToolTip="Close"/>
            </StackPanel>
        </Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="36,0,36,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,16">
                <TextBlock x:Name="QueueSummary" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Caption}"/>
            </Grid>
            <StackPanel Grid.Row="1">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton x:Name="CopyModeCheck" Content="Copy &amp; verify" GroupName="Mode" IsChecked="True" Checked="Mode_Changed"/>
                    <RadioButton x:Name="VerifyOnlyCheck" Content="Verify only" GroupName="Mode" Checked="Mode_Changed"/>
                    <RadioButton x:Name="MirrorCheck" Content="Mirror" GroupName="Mode" Checked="Mode_Changed"/>
                </StackPanel>
                <TextBlock x:Name="ModeDescription" Style="{StaticResource Caption}" Text="Copy files, then compare every file with SHA-256." TextWrapping="Wrap"/>
                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Margin="0,16,0,20"/>
            </StackPanel>
            <StackPanel Grid.Row="2">
                <Grid Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="FROM" Style="{StaticResource Caption}"/><TextBlock x:Name="QueueCount" Style="{StaticResource Caption}" Margin="12,0,0,0"/></StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="AddFilesButton" Content="Add files" Click="AddFiles_Click" Padding="10,5" Margin="0,0,6,0"/>
                        <Button x:Name="AddFolderButton" Content="Add folder" Click="AddFolder_Click" Padding="10,5"/>
                    </StackPanel>
                </Grid>
                <Grid>
                    <ListView x:Name="JobsList" MaxHeight="190" MinHeight="88" Background="Transparent" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                              SelectionMode="Extended" SelectionChanged="Jobs_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10,8"/></Style></ListView.ItemContainerStyle>
                        <ListView.ItemTemplate><DataTemplate>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Source}" ToolTip="{Binding Source}" Style="{StaticResource Path}" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding ResolvedTarget}" ToolTip="{Binding ResolvedTarget}" Style="{StaticResource Path}" TextTrimming="None" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontWeight="Medium"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" MaxWidth="220" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/><TextBlock Text="{Binding Elapsed}" Style="{StaticResource Caption}"/></StackPanel>
                            </Grid>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptyHint" Text="Drop files or folders here, or add them above." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Dim}" IsHitTestVisible="False"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,14">
                    <Button x:Name="RemoveButton" Content="Remove selected" Click="Remove_Click" Padding="10,4" Margin="0,0,6,0"/>
                    <Button x:Name="ClearButton" Content="Clear finished" Click="Clear_Click" Padding="10,4"/>
                </StackPanel>
                <TextBlock Text="TO · DESTINATION FOLDER" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                <DockPanel>
                    <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Browse…" Click="BrowseDestination_Click" Margin="8,0,0,0"/>
                    <TextBox x:Name="DestinationBox" TextChanged="Destination_Changed" FontFamily="./Fonts/#IBM Plex Mono" FontSize="12" VerticalContentAlignment="Center" AutomationProperties.Name="Destination folder"/>
                </DockPanel>
                <TextBlock Text="Each folder keeps its name inside the destination. Individual files go directly inside it." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
            <Grid Grid.Row="3" Margin="0,28,0,22">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="CopyPhase" Text="01  Copy" Foreground="{DynamicResource Dim}"/>
                <Border Grid.Column="1" Height="1" Background="{DynamicResource Line}" Margin="18,0"/>
                <TextBlock Grid.Column="2" x:Name="VerifyPhase" Text="02  Verify" Foreground="{DynamicResource Dim}"/>
                <Border Grid.Column="3" Height="1" Background="{DynamicResource Line}" Margin="18,0"/>
                <TextBlock Grid.Column="4" x:Name="ResultPhase" Text="03  Result" Foreground="{DynamicResource Dim}"/>
            </Grid>
            <StackPanel Grid.Row="4">
                <TextBlock x:Name="OutcomeTitle" Text="A copy you can trust." FontFamily="./Fonts/#Bricolage Grotesque" FontWeight="Medium" FontSize="32" TextWrapping="Wrap"/>
                <TextBlock x:Name="StatusText" Text="Add your sources and choose a destination to begin." Foreground="{DynamicResource Dim}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <TextBlock x:Name="OutcomeError" Visibility="Collapsed" Foreground="{DynamicResource Failure}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <ProgressBar x:Name="Progress" Height="5" Minimum="0" Maximum="100" Background="{DynamicResource Line}" Foreground="{DynamicResource Accent}" BorderThickness="0" Margin="0,20,0,10"/>
                <Grid><TextBlock x:Name="ProgressText" Style="{StaticResource Caption}" Text="Ready when you are"/><TextBlock Text="SHA-256" Style="{StaticResource Path}" HorizontalAlignment="Right"/></Grid>
            </StackPanel>
            <WrapPanel Grid.Row="5" x:Name="ActionsPanel" GotKeyboardFocus="Actions_GotKeyboardFocus" Margin="0,20,0,6">
                <Button x:Name="CopyButton" Content="Copy and verify" Style="{StaticResource Primary}" Click="Copy_Click" Margin="0,0,8,8"/>
                <Button x:Name="CancelButton" Content="Stop safely" Click="Cancel_Click" IsEnabled="False" Visibility="Collapsed" Margin="0,0,8,8"/>
                <Button x:Name="OpenDestinationButton" Content="Open destination" Click="OpenDestination_Click" Visibility="Collapsed" Margin="0,0,8,8"/>
                <Button x:Name="ViewLogButton" Content="View log" Click="ViewLog_Click" Visibility="Collapsed" Margin="0,0,8,8"/>
            </WrapPanel>
            <Expander Grid.Row="6" x:Name="DetailsExpander" Header="File details">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock x:Name="ResultsCount" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                    <TextBlock x:Name="ResultsHint" Text="Per-file verification results appear here after checking starts." Style="{StaticResource Caption}"/>
                    <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" MinHeight="90" MaxHeight="240"
                              Background="{DynamicResource Paper}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Line}" RowBackground="{DynamicResource Paper}" AlternatingRowBackground="{DynamicResource Paper}" SelectionUnit="FullRow" RowDetailsVisibilityMode="VisibleWhenSelected">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File" Binding="{Binding File}" Width="2*"/>
                            <DataGridTextColumn Header="Verdict" Binding="{Binding Status}" Width="110"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding Brush}"/><Setter Property="ToolTip" Value="{Binding Status}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/></DataTrigger></Style.Triggers></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="85"/>
                            <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="3*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="ToolTip" Value="{Binding Destination}"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="3"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                        </DataGrid.Columns>
                        <DataGrid.RowDetailsTemplate><DataTemplate><StackPanel Margin="12" Background="{DynamicResource Paper}"><TextBlock Text="Source" Style="{StaticResource Caption}"/><TextBox Text="{Binding Source}" IsReadOnly="True" BorderThickness="0"/><TextBlock Text="Destination" Style="{StaticResource Caption}"/><TextBox Text="{Binding Destination}" IsReadOnly="True" BorderThickness="0"/></StackPanel></DataTemplate></DataGrid.RowDetailsTemplate>
                    </DataGrid>
                </StackPanel>
            </Expander>
            <Expander Grid.Row="7" x:Name="LogExpander" Header="Activity log">
                <StackPanel Margin="0,12,0,0">
                    <DockPanel Margin="0,0,0,8"><Button x:Name="AllLanesButton" Content="All jobs" Click="AllLanes_Click" DockPanel.Dock="Right" Padding="10,3" Visibility="Collapsed"/><TextBlock x:Name="LogHeader" Text="LOG · ALL JOBS" Style="{StaticResource Caption}"/></DockPanel>
                    <TextBox x:Name="LogBox" Height="170" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="./Fonts/#IBM Plex Mono" FontSize="12" AutomationProperties.Name="Activity log"/>
                </StackPanel>
            </Expander>
        </Grid>
    </ScrollViewer>
    </DockPanel>
</Window>
