<Window x:Class="Bunshin.Gui.BunshinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="None"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Branding/bunshin.ico"
        Background="{DynamicResource Paper}" Foreground="{DynamicResource Ink}"
        FontFamily="./Fonts/#Space Grotesk" FontSize="14">
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="64" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12">
        <StackPanel>
            <Grid Height="64" Margin="24,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Image Source="{StaticResource BrandMark}" Width="26" Height="26" Margin="0,0,9,0"/>
                    <TextBlock Text="Bunshin" FontFamily="./Fonts/#Bricolage Grotesque" FontWeight="SemiBold" FontSize="20"/>
                </StackPanel>
                <Button Content="&#xE8BB;" Style="{StaticResource WindowControl}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Cancel_Click" AutomationProperties.Name="Close dialog" ToolTip="Close"/>
            </Grid>
            <StackPanel Margin="24,0,24,24">
                <TextBlock x:Name="Heading" FontFamily="./Fonts/#Bricolage Grotesque" FontSize="26" FontWeight="Medium" TextWrapping="Wrap" Margin="0,4,0,16"/>
                <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,0,8,0" Foreground="{DynamicResource Dim}"/>
                </ScrollViewer>
                <WrapPanel HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button x:Name="DeclineButton" Content="Cancel" AutomationProperties.AutomationId="7" IsCancel="True" IsDefault="True" Click="Cancel_Click" Margin="0,0,8,0" MinWidth="88"/>
                    <Button x:Name="AcceptButton" Content="OK" AutomationProperties.AutomationId="2" Click="Accept_Click" Style="{StaticResource Primary}" MinWidth="88"/>
                </WrapPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
